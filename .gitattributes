# ---------------------------------------------------------------------------
# GitHub language statistics — linguist overrides.
# The repo commits generated outputs (plotly/interactive + raster figures,
# result tables, notebooks used as analysis narratives). Without these rules
# linguist counts ~245 MB of plotly HTML as "HTML", burying the actual Python
# source. These files stay in the repository (reports link them, the released
# artifact bundle depends on them) — they are only excluded from the stats bar.
# ---------------------------------------------------------------------------

# Interactive plotly DAGs / convergence / CATE / uplift / ROI / sensitivity figs
results/figures/*.html     linguist-generated=true

# Raster exports (EDA + README gallery, regenerated by scripts/export_readme_figures.py)
results/figures/*.png      linguist-generated=true

# Analysis result tables are outputs of the pipeline, not source
results/**/*.csv           linguist-generated=true
results/**/*.parquet       linguist-generated=true

# Intermediate data artifacts (simulated marketing layer, processed features)
data/**/*.csv              linguist-generated=true
data/**/*.parquet          linguist-generated=true

# Notebooks are analysis narratives driven by the modules in src/ (source of truth)
notebooks/*.ipynb          linguist-generated=true

# Documentation is never a programming language in the stats bar
*.md                       linguist-documentation